@inject NavigationManager Navigation
@inject IAuthService _authService;
@* @rendermode InteractiveServer *@


    <Toasts class="p-3" Messages="messages" Placement="ToastsPlacement.TopRight" />
    
        <div class="input-group-custom">
            <span><i class="fas fa-user"></i></span>
            <input type="text" @bind="@Username" placeholder="Username" required>
        </div>


    <button type="submit" class="btn-login" @onclick="SendOtp">
        <i class="fas fa-arrow-right-to-bracket me-2"></i> Send 
    </button>

    <div class="d-flex align-items-center justify-content-end gap-2 mb-3">
    <label class="form-check-label"  for="rememberCheck" style="color:#334155;">
       have an acoount?
    </label>   

    <a href="#" @onclick="CallParent" class="forgot-link">Login</a>

       
    </div>

@code {

    [Parameter]
    public EventCallback OnForgotSwitch { get; set; }

    private string? Username { get; set; }

    private string? SuccessMessage { get; set; }
    private string? Otp { get; set; }

    private string? ErrorMessage { get; set; }


    private List<ToastMessage> messages = new();

    private async Task CallParent()
    {
        await OnForgotSwitch.InvokeAsync();
    }

    private  async Task SendOtp ()
    {
        try
        {
            if (Username!=null)
            {
                var response = await _authService.ForgortPasswordAsync(Username);

                if (response.Success )
                {
                    if (response.Message != null)
                    {
                        messages.Add(new ToastMessage
                            {
                                Type = ToastType.Success,
                                Title = "Success",
                            Message = response.Message
                            });
                        Otp = response.Data;
                    }
                }
                else
                {
                    messages.Add(new ToastMessage
                    {
                        Type = ToastType.Danger,
                        Title = "Failed",
                        Message = response.Message
                    });
                    
                }
            }

        }catch(Exception ex)
        {
            messages.Add(new ToastMessage
            {
                Type = ToastType.Danger,
                Title = "Failed",
                Message = "Something went wrong!"
            });
            
        }

    }

}
