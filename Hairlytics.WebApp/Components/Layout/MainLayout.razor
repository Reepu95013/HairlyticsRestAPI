@inherits LayoutComponentBase

<LoaderComponent />
<NavigationLoader />

<AuthorizeView>
    <Authorized>
        <div class="wrapper">
            <NavMenu />
            <div class="main-content">
                <HeaderComponent />
               @Body
               <PageReadyNotifier />
            </div>
        </div>
      
    </Authorized>

    <NotAuthorized>
        @Body
        <PageReadyNotifier />
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
