@attribute [Authorize]
@page "/Employee"
@inject NavigationManager navigationManager
@inject IUserService _userService
@inject LoadingService LoadingService
@rendermode InteractiveServer

<Toasts class="p-3" Messages="messages" Placement="ToastsPlacement.TopRight" />

<div class="section-card" id="employeeSection">
    <div class="d-flex align-items-center justify-content-between">
        <h4 class="section-title mb-0"><i class="fas fa-user-tie me-2" style="color:#d4a373;"></i> Employee management</h4>
        <button class="btn-outline-admin py-lg-2" @onclick="GoToAddUser"><i class="fas fa-plus me-1"></i> Add employee</button>
    </div>
    <div class="table-responsive mt-3">
        <table class="table table-admin align-middle">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Last name</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (pagedResult.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-4">No sub-admin employees found.</td>
                    </tr>
                }
                @foreach (var emp in pagedResult.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-sm">@GetInitials(emp.Name, emp.LastName)</span>
                                <div>@emp.Name <br><small class="text-secondary">@emp.Email</small></div>
                            </div>
                        </td>
                        <td>@emp.LastName</td>
                        <td>@emp.Phone</td>
                        <td>
                            @if (emp.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis px-3 py-2 rounded-pill">active</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-2 rounded-pill">inactive</span>
                            }
                        </td>
                        <td><span class="badge bg-info-subtle text-dark px-3 py-2 rounded-pill">sub-admin</span></td>
                        <td>
                            <button class="btn-icon-none" @onclick="() => UpdateUser(emp.Id)">
                                <i class="fas fa-edit text-secondary me-3"></i>
                            </button>
                            @if (!emp.IsActive)
                            {
                                <button class="btn-icon-none" @onclick="() => ActivateUser(emp.Id)" title="Activate">
                                    <i class="fas fa-user-check text-success"></i>
                                </button>
                            }
                            <button class="btn-icon-none" @onclick="() => DeleteUser(emp.Id)">
                                <i class="fas fa-trash-alt text-danger-light"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <PaginationComponent PageNumber="@pagedResult.PageNumber"
                         PageSize="@pagedResult.PageSize"
                         TotalCount="@pagedResult.TotalCount"
                         OnPageChanged="HandlePageChanged" />
</div>

@code {
    PagedResultDto<UserResponseDto> pagedResult = new();
    private List<ToastMessage> messages = new();
    int pageNo = 1;
    int pageSize = 10;

    protected override async Task OnInitializedAsync() =>
        await LoadingService.ExecuteAsync(LoadEmployees);

    async Task LoadEmployees()
    {
        pagedResult = await _userService.GetUsersPagedAsync(UserRole.SubAdmin, pageNo, pageSize);
    }

    void GoToAddUser() => navigationManager.NavigateTo("/Add-User?role=SubAdmin", true);
    void UpdateUser(int id) => navigationManager.NavigateTo($"/Edit-User/{id}", true);

    async Task HandlePageChanged(PaginationComponent.PaginationState state)
    {
        pageNo = state.PageNumber;
        pageSize = state.PageSize;
        await LoadingService.ExecuteAsync(LoadEmployees);
    }

    async Task DeleteUser(int id) =>
        await LoadingService.ExecuteAsync(async () =>
        {
            var response = await _userService.DeleteUserAsync(id);
            ShowToast(response.Success, response.Data ?? response.Message);
            if (response.Success) await LoadEmployees();
        });

    async Task ActivateUser(int id) =>
        await LoadingService.ExecuteAsync(async () =>
        {
            var response = await _userService.ActiveUser(id);
            ShowToast(response.Success, response.Message);
            if (response.Success) await LoadEmployees();
        });

    void ShowToast(bool success, string? message)
    {
        messages.Add(new ToastMessage
        {
            Type = success ? ToastType.Success : ToastType.Danger,
            Title = success ? "Success" : "Error",
            Message = message ?? ""
        });
    }

    static string GetInitials(string name, string? lastName)
    {
        var a = string.IsNullOrEmpty(name) ? "?" : name[0].ToString().ToUpper();
        var b = string.IsNullOrEmpty(lastName) ? "" : lastName[0].ToString().ToUpper();
        return a + b;
    }
}
