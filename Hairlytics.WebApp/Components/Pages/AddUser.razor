@attribute [Authorize]
@page "/Add-User"

@inject IAuthService _authService
@inject IFileService _fileService
@inject IEmailService _emailService
@inject LoadingService LoadingService
@rendermode InteractiveServer



<Toasts class="p-3" Messages="messages" Placement="ToastsPlacement.TopRight" />
<div class="page-header">
    <div class="header-title d-flex align-items-center">
        <h2><i class="fas fa-user-plus me-3" style="color:#d4a373;"></i>Add new user</h2>
        <span class="badge-salon ms-3"><i class="fas fa-users me-1"></i> role management</span>
    </div>
</div>




<div class="section-card">
    <h4 class="section-title">User information</h4>

    <EditForm Model="@userCreateDto" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div id="addUserForm">
        <div class="row">
            <!-- First Name + Last Name -->   
            <div class="col-md-6 form-row">
                <label class="form-label"><i class="fas fa-user me-1"></i> First name *</label>
                <div class="input-group-custom  py-0 px-3">
                   <input type="text" placeholder="Enter first name" @bind="userCreateDto.Name" required>
                </div>
            </div>      
            

            <div class="col-md-6 form-row">
                <label class="form-label"><i class="fas fa-user me-1"></i> Last name *</label>
                <div class="input-group-custom py-0 px-3">
                    <input type="text" placeholder="Enter last name" @bind="userCreateDto.LastName" required>
                </div>
            </div>

        </div>

        <div class="row">
            <!-- Username -->


            <div class="col-md-6 form-row">
                <label class="form-label"><i class="fas fa-user me-1"></i> Username *</label>
                <div class="input-group-custom  py-0 px-3">
                    <input type="text" placeholder="Username" @bind="userCreateDto.Username" required>
                </div>
            </div>

           <!-- Email -->
            <div class="col-md-6 form-row">
                <label class="form-label"><i class="fas fa-envelope me-1"></i> Email address *</label>
                <div class="input-group-custom  py-0 px-3">
                    <input type="email" placeholder="name@example.com" @bind="userCreateDto.Email" required>
                </div>
               
            </div>
        </div>

        <div class="row">
            <!-- Password -->
            <div class="col-md-6 form-row">
                <label class="form-label"><i class="fas fa-lock me-1"></i> Password *</label>
                <div class="input-group-custom  py-0 px-3">
                    <input type="password" placeholder="••••••••" @bind="userCreateDto.Password" required>
                </div>
               <small class="text-secondary">min. 8 characters</small>
            </div>
            <!-- Phone Number -->
            <div class="col-md-6 form-row">
                <label class="form-label"><i class="fas fa-phone-alt me-1"></i> Phone number *</label>
                <div class="input-group-custom  py-0 px-3">
                    <input type="tel" placeholder="+1 234 567 890" @bind="userCreateDto.Phone"  required>
                </div>
               </div>
        </div>

        <!-- Role selection: Sub-admin, User, Vendor (selected by default: User) -->
        <hr class="mt-4">

        <div class="row">
            <div class="col-12">
                <label class="form-label">
                    <i class="fa-solid fa-user-shield"></i> Role *
                </label>

                <select class="input-group-custom w-100 py-3 px-3" value="@userCreateDto.Role" @onchange="OnRoleChanged">
                    <option value=@UserRole.Customer>Customer</option>
                    <option value=@UserRole.SubAdmin>Sub-Admin</option>
                    <option value=@UserRole.Vendor>Vendor</option>
                </select>
            </div>
        </div>


       
        
        @if (userCreateDto.Role == UserRole.Vendor && userCreateDto.VendorProfileCreateDto != null)
        {
            <div class="row">
                <!-- shop name -->
                <div class="col-md-6 form-row">
                    <label class="form-label"><i class="fa-solid fa-shop"></i> Shop Name *</label>
                    <div class="input-group-custom  py-0 px-3">
                        <input type="text" placeholder="Shop Name" @bind="userCreateDto.VendorProfileCreateDto.ShopName" required>
                    </div>
                </div>

                <!-- shop Phone Number -->
                <div class="col-md-6 form-row">
                    <label class="form-label"><i class="fas fa-phone-alt me-1"></i>Telephone *</label>
                    <div class="input-group-custom  py-0 px-3">
                        <input type="tel" placeholder="+1 234 567 890" @bind="userCreateDto.VendorProfileCreateDto.ShopTelephone" required>
                    </div>
                </div>
            </div>


            <div class="row">
                <!-- shop address -->
                <div class="col-md-6 form-row">
                    <label class="form-label"> <i class="fa-solid fa-location-dot"></i> Address *</label>
                    <div class="input-group-custom  py-0 px-3">
                            <input type="text" placeholder="Shop Address" @bind="userCreateDto.VendorProfileCreateDto.Address"  required>
                    </div>
                </div>

                <!-- shop city -->
                <div class="col-md-6 form-row">
                    <label class="form-label"> <i class="fa-solid fa-city"></i> City *</label>
                    <div class="input-group-custom  py-0 px-3">
                            <input type="text" placeholder="City" @bind="userCreateDto.VendorProfileCreateDto.City"  required>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- shop region -->
                <div class="col-md-6 form-row">
                    <label class="form-label"> <i class="fa-solid fa-archway"></i> Region *</label>
                    <div class="input-group-custom  py-0 px-3">
                        <input type="text" placeholder="Shop Region" @bind="userCreateDto.VendorProfileCreateDto.Region"  required>
                    </div>
                </div>

                <!-- shop city -->
                <div class="col-md-6 form-row">
                    <label class="form-label"><i class="fa-solid fa-flag"></i> Country *</label>
                    <div class="input-group-custom  py-0 px-3">
                        <input type="text" placeholder="Country" @bind="userCreateDto.VendorProfileCreateDto.Country" required>
                    </div>
                </div>
            </div>



            <div class="row">
                <!-- shop region -->
                <div class="col-md-6 form-row">
                    <label class="form-label"> <i class="fa-solid fa-map-pin"></i> PostalCode *</label>
                    <div class="input-group-custom  py-0 px-3">
                        <input type="text" placeholder="PostalCode" @bind="userCreateDto.VendorProfileCreateDto.PostalCode"  required>
                    </div>
                </div>

                <!-- shop city -->
                <div class="col-md-6 form-row">
                    <label class="form-label"> <i class="fa-solid fa-file"></i> GST Number *</label>
                    <div class="input-group-custom  py-0 px-3">
                        <input type="text" placeholder="GST Number" @bind="userCreateDto.VendorProfileCreateDto.TaxNumber" required>
                    </div>
                </div>
            </div>
        }
              

        @if (userCreateDto.VendorProfileCreateDto?.VendorDocumentCreateDto != null)
        {
             <hr class="mt-4">

            <div class="d-flex justify-content-end">
                <button type="button" class="btn-outline-admin py-lg-2" @onclick="AddDocument">
                    <i class="fas fa-plus me-2"></i> Add Document
                </button>
            </div>

            @foreach (var doc in userCreateDto.VendorProfileCreateDto.VendorDocumentCreateDto)
            {
                <div class="row align-items-center">
                    <!-- Document Type -->
                    <div class="col-md-4">
                        <label class="form-label">Document Type</label>
                       
                            <InputSelect @bind-Value="doc.DocumentType" class="input-group-custom w-100 py-2 px-3">
                                <option value="">Select Document</option>
                                <option value="Aadhar">Aadhar</option>
                                <option value="PAN">PAN</option>
                                <option value="License">License</option>
                            </InputSelect>
                    </div>

                    <!-- File Upload -->
                    <div class="col-md-5">
                        <label class="form-label">Upload File</label>
                        @* <input type="file" class="input-group-custom w-100 py-2 px-3" /> *@
                            <InputFile class="input-group-custom w-100 py-2 px-3"
                                       OnChange="e => HandleFileUpload(e, doc)" />
                    </div>
                    <div class="col-md-1">
                        <button type="button" @onclick="() =>RemoveDocument(doc)">
                            <i class="fas fa-trash-alt text-danger-light"></i>
                        </button>

                    </div>

                </div>
            }

        }
        <!-- submit + cancel buttons with navigation to "form route" -->
      
        <div class="d-flex gap-3 mt-4 pt-2">
          <button type="submit" class="btn-outline-admin py-lg-2">
                <i class="fas fa-save me-2"></i> Create user
          </button>
            <button type="button" class="btn-outline-admin py-lg-2" @onclick="ClearForm">
            <i class="fas fa-times me-2"></i> Cancel
          </button>
        </div>
    </div>

    </EditForm>


    <!-- additional hint: route simulation (demo) -->
    <hr class="mt-4">
    <div class="d-flex align-items-center justify-content-between text-secondary small">
        <span><i class="fas fa-route me-1"></i> Hairlytics</span>
        <span><svg class="icon-salon" viewBox="0 0 24 24" width="18"><path d="M5 12 L19 12 M12 5 L19 12 L12 19" /></svg> Hairlytics comming soon</span>
    </div>
</div>

@code {

    [SupplyParameterFromQuery(Name = "role")]
    public string? RoleQuery { get; set; }

    private List<ToastMessage> messages = new();

    private UserCreateDto userCreateDto { get; set; } = new UserCreateDto
    {
        Name = "",
        LastName="",
        Email="",
        Username="",
        Phone="",
        Password="",
        Role=UserRole.Customer,
        VendorProfileCreateDto =null       
    };




    protected override void OnInitialized()
    {
        ApplyRoleFromQuery();
    }

    private void ApplyRoleFromQuery()
    {
        if (string.IsNullOrWhiteSpace(RoleQuery))
            return;

        if (Enum.TryParse<UserRole>(RoleQuery, ignoreCase: true, out var role) &&
            role is UserRole.Customer or UserRole.Vendor or UserRole.SubAdmin)
        {
            userCreateDto.Role = role;
            EnsureVendorProfileForRole();
        }
    }

    private void OnRoleChanged(ChangeEventArgs e)
    {
        userCreateDto.Role = Enum.Parse<UserRole>(e.Value!.ToString()!);
        EnsureVendorProfileForRole();
    }

    private void EnsureVendorProfileForRole()
    {
        if (userCreateDto.Role == UserRole.Vendor)
        {
            userCreateDto.VendorProfileCreateDto = new VendorProfileCreateDto
            {
                ShopName = "",
                City = "",
                Address = "",
                Country = "",
                Description = "",
                PostalCode = "",
                Region = "",
                ShopTelephone = "",
                TaxNumber = "",
                VendorDocumentCreateDto = new List<VendorDocumentCreateDto>()
            };
        }
        else
        {
            userCreateDto.VendorProfileCreateDto = null;
        }
    }



    private void AddDocument()
    {
        userCreateDto.VendorProfileCreateDto?.VendorDocumentCreateDto?.Add(
            new VendorDocumentCreateDto
            { 
               DocumentType="",
               FilePath="",   
            }
        );
    }

    private Task RemoveDocument(VendorDocumentCreateDto doc)
    {
        if (doc == null)
            return Task.CompletedTask;

        bool res = true;

        if (!string.IsNullOrWhiteSpace(doc.FilePath))
        {
            res = _fileService.DeleteFile(doc.FilePath);
        }

        if (res)
        {
            userCreateDto.VendorProfileCreateDto?.VendorDocumentCreateDto?.Remove(doc);
        }

        return Task.CompletedTask;
    }




    private void ClearForm()
    {
        userCreateDto = new UserCreateDto
        {
            Name = "",
            LastName = "",
            Email = "",
            Username = "",
            Phone = "",
            Password = "",
            Role = UserRole.Customer,
            VendorProfileCreateDto = null
        };       
    }



    private async Task<IFormFile> ConvertToIFormFile(IBrowserFile file)
    {
        var stream = file.OpenReadStream(10 * 1024 * 1024); // max 10MB
        var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        ms.Position = 0;

        return new FormFile(ms, 0, ms.Length, file.Name, file.Name)
        {
            Headers = new HeaderDictionary(),
            ContentType = file.ContentType
        };
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e, VendorDocumentCreateDto doc)
    {
        if (!string.IsNullOrWhiteSpace(doc.FilePath))
        {
            _fileService.DeleteFile(doc.FilePath);

        }

        var file = e.File;

        // 🔥 Optional validation (size limit 2MB)
        if (file.Size > 2 * 1024 * 1024)
        {
            messages.Add(new ToastMessage
            {
                Type = ToastType.Danger,
                Title = "Error",
                Message = "File must be less than 2MB"
            });
            return;
        }

        var formFile = await ConvertToIFormFile(file);

        var fileName = await _fileService.SaveFileAsync(formFile, "vendor");
        doc.FilePath = fileName;
    }


    private async Task HandleSubmit() =>
        await LoadingService.ExecuteAsync(async () =>
        {
            if (userCreateDto.Role == UserRole.Vendor)
            {
                var docs = userCreateDto.VendorProfileCreateDto?.VendorDocumentCreateDto;
                if (docs == null || docs.Count < 3)
                {
                    messages.Add(new ToastMessage { Type = ToastType.Danger, Title = "Failed", Message = "Please add at least 3 documents" });
                    return;
                }
                var invalidDocs = docs.Any(d => string.IsNullOrWhiteSpace(d.DocumentType) || d.FilePath == null || d.FilePath.Length == 0);
                if (invalidDocs)
                {
                    messages.Add(new ToastMessage { Type = ToastType.Danger, Title = "Failed", Message = "Please fill all document details and upload files" });
                    return;
                }
            }

            var userpassword = userCreateDto.Password;
            var response = await _authService.RegisterAdminAsync(userCreateDto);

            if (response.Success)
            {
                messages.Add(new ToastMessage { Type = ToastType.Success, Title = "Success!", Message = response.Message });
                if (userCreateDto.Role == UserRole.Vendor)
                {
                    _emailService.SendEmail(new EmailDto(userCreateDto.Email, "No Reply",
                        EmailBody.EmailStringBody($"Your account has been created successfully. Your username is {userCreateDto.Username} and password is {userpassword}. Please wait for admin approval.")));
                }
                else
                {
                    _emailService.SendEmail(new EmailDto(userCreateDto.Email, "No Reply",
                        EmailBody.EmailStringBody($"Your Account has been created successfuly, and your username is {userCreateDto.Username} and password is {userpassword} .")));
                }
                ClearForm();
            }
            else
            {
                messages.Add(new ToastMessage { Type = ToastType.Danger, Title = "Failed", Message = response.Message });
            }
        });


}
