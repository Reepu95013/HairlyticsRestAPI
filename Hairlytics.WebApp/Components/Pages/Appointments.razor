@attribute [Authorize]
@page "/Appointments"
@inject NavigationManager navigationManager
@inject IUserService _userService
@inject IBookingService _bookingService
@inject LoadingService LoadingService
@rendermode InteractiveServer

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-cut"></i></div>
            <div>
                <span class="text-secondary-emphasis small text-uppercase">Today's bookings</span>
                <h3 class="fw-bold mb-0">@todayBooking</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-hourglass-half"></i></div>
            <div>
                <span class="text-secondary-emphasis small">PENDING</span>
                <h3 class="fw-bold mb-0">@todayPendingBooking</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-check-circle"></i></div>
            <div>
                <span class="text-secondary-emphasis small">COMPLETED</span>
                <h3 class="fw-bold mb-0">@todayCompleteBooking</h3>
            </div>
        </div>
    </div>
</div>

<div class="section-card">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="section-title mb-0"><i class="fa-solid fa-clock" style="color:#d4a373;"></i> Today's schedule</h4>
    </div>
    <div class="table-responsive">
        <table class="table table-admin">
            <thead><tr><th>Vendor</th><th>Salon</th><th>Description</th><th>Phone</th><th>Action</th></tr></thead>
            <tbody>
                @foreach (var vendor in pagedResult.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-sm">@vendor.Name[0]@vendor.LastName?[0]</span>
                                <div>@vendor.Name <br><small class="text-secondary">@vendor.Email</small></div>
                            </div>
                        </td>
                        <td>@vendor.VendorProfileResponseDto?.ShopName</td>
                        <td>@vendor.VendorProfileResponseDto?.Description</td>
                        <td>@vendor.VendorProfileResponseDto?.ShopTelephone</td>
                        <td>
                            @if (vendor?.VendorProfileResponseDto?.Id != null)
                            {
                                <i class="fas fa-eye" style="cursor:pointer"
                                   @onclick="() => GoToAppointmentView(vendor.VendorProfileResponseDto.Id)"></i>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <PaginationComponent PageNumber="@pagedResult.PageNumber"
                         PageSize="@pagedResult.PageSize"
                         TotalCount="@pagedResult.TotalCount"
                         OnPageChanged="HandlePageChanged" />
</div>

@code {
    PagedResultDto<UserResponseDto> pagedResult = new();
    int pageNo = 1;
    int pageSize = 10;
    int todayBooking;
    int todayPendingBooking;
    int todayCompleteBooking;

    protected override async Task OnInitializedAsync() =>
        await LoadingService.ExecuteAsync(async () =>
        {
            await GetTodayBookingCount();
            await LoadVendors();
        });

    async Task LoadVendors()
    {
        pagedResult = await _userService.GetUsersPagedAsync(UserRole.Vendor, pageNo, pageSize);
    }

    async Task HandlePageChanged(PaginationComponent.PaginationState state)
    {
        pageNo = state.PageNumber;
        pageSize = state.PageSize;
        await LoadingService.ExecuteAsync(LoadVendors);
    }

    async Task GetTodayBookingCount()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        todayPendingBooking = (await _bookingService.GetBookingCount(today, BookingStatus.Pending)).Data;
        todayCompleteBooking = (await _bookingService.GetBookingCount(today, BookingStatus.Completed)).Data;
        todayBooking = todayPendingBooking + todayCompleteBooking;
    }

    void GoToAppointmentView(int id) => navigationManager.NavigateTo($"/AppointmentView/{id}", true);
}
