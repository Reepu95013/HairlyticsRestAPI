@attribute [Authorize]
@page "/Appointments"

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-cut"></i></div>
            <div>
                <span class="text-secondary-emphasis small text-uppercase">Today's bookings</span>
                <h3 class="fw-bold mb-0">24</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-hourglass-half"></i></div>
            <div>
                <span class="text-secondary-emphasis small">PENDING</span>
                <h3 class="fw-bold mb-0">12</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-check-circle"></i></div>
            <div>
                <span class="text-secondary-emphasis small">CONFIRMED</span>
                <h3 class="fw-bold mb-0">18</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-dollar-sign"></i></div>
            <div>
                <span class="text-secondary-emphasis small">REVENUE </span>
                <h3 class="fw-bold mb-0">$1,280</h3>
            </div>
        </div>
    </div>
</div>

@code {

}
