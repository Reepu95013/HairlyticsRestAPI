@attribute [Authorize]
@page "/Users"
@inject IUserService _userService
@inject NavigationManager navigationManager
@inject LoadingService LoadingService
@rendermode InteractiveServer

<Toasts class="p-3" Messages="messages" Placement="ToastsPlacement.TopRight" />

<div class="section-card">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="section-title mb-0"><i class="fas fa-user-friends me-2" style="color:#d4a373;"></i> Users (Customers)</h4>
        <button class="btn-outline-admin py-lg-2" @onclick="GoToAddUser">
            <i class="fas fa-plus me-1"></i> Add user
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-admin align-middle">
            <thead>
                <tr><th>User</th><th>Username</th><th>Phone</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @if (pagedResult.Items.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">No users found.</td></tr>
                }
                @foreach (var user in pagedResult.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-sm">@(user.Name.Length > 0 ? user.Name[0] : '?')</span>
                                <div>@user.Name @user.LastName<br><small class="text-secondary">@user.Email</small></div>
                            </div>
                        </td>
                        <td>@user.Username</td>
                        <td>@user.Phone</td>
                        <td>@(user.IsActive ? "Active" : "Inactive")</td>
                        <td>
                            <i class="fas fa-edit text-secondary me-3" style="cursor:pointer" @onclick="() => EditUser(user.Id)"></i>
                            @if (!user.IsActive)
                            {
                                <i class="fas fa-user-check text-success me-2" style="cursor:pointer" @onclick="() => ActivateUser(user.Id)"></i>
                            }
                            <i class="fas fa-trash-alt text-danger-light" style="cursor:pointer" @onclick="() => DeleteUser(user.Id)"></i>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <PaginationComponent PageNumber="@pagedResult.PageNumber"
                         PageSize="@pagedResult.PageSize"
                         TotalCount="@pagedResult.TotalCount"
                         OnPageChanged="HandlePageChanged" />
</div>

@code {
    PagedResultDto<UserResponseDto> pagedResult = new();
    private List<ToastMessage> messages = new();
    int pageNo = 1;
    int pageSize = 10;

    protected override async Task OnInitializedAsync() =>
        await LoadingService.ExecuteAsync(LoadUsers);

    async Task LoadUsers()
    {
        pagedResult = await _userService.GetUsersPagedAsync(UserRole.Customer, pageNo, pageSize);
    }

    async Task HandlePageChanged(PaginationComponent.PaginationState state)
    {
        pageNo = state.PageNumber;
        pageSize = state.PageSize;
        await LoadingService.ExecuteAsync(LoadUsers);
    }

    void GoToAddUser() => navigationManager.NavigateTo("/Add-User?role=Customer", true);
    void EditUser(int id) => navigationManager.NavigateTo($"/Edit-User/{id}", true);

    async Task DeleteUser(int id) =>
        await LoadingService.ExecuteAsync(async () =>
        {
            var response = await _userService.DeleteUserAsync(id);
            ShowToast(response.Success, response.Data ?? response.Message);
            if (response.Success) await LoadUsers();
        });

    async Task ActivateUser(int id) =>
        await LoadingService.ExecuteAsync(async () =>
        {
            var response = await _userService.ActiveUser(id);
            ShowToast(response.Success, response.Message);
            if (response.Success) await LoadUsers();
        });

    void ShowToast(bool success, string? message)
    {
        messages.Add(new ToastMessage
        {
            Type = success ? ToastType.Success : ToastType.Danger,
            Title = success ? "Success" : "Error",
            Message = message ?? ""
        });
    }
}
