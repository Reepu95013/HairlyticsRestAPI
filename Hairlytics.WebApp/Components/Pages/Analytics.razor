@attribute [Authorize]
@page "/Analytics"
@inject IHelperService _helperService
@inject IBookingService _bookingService
@inject LoadingService LoadingService
@rendermode InteractiveServer

<div class="page-header mb-2">
    <div class="header-title d-flex align-items-center">
        <h2><i class="fas fa-chart-line me-3" style="color:#d4a373;"></i> Analytics</h2>
        <span class="badge-salon ms-3"><i class="fas fa-database me-1"></i> platform overview</span>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-calendar-day"></i></div>
            <div>
                <span class="text-secondary-emphasis small">TODAY'S BOOKINGS</span>
                <h3 class="fw-bold mb-0">@todayTotalBookings</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-hourglass-half"></i></div>
            <div>
                <span class="text-secondary-emphasis small">PENDING TODAY</span>
                <h3 class="fw-bold mb-0">@todayPending</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-check-circle"></i></div>
            <div>
                <span class="text-secondary-emphasis small">COMPLETED TODAY</span>
                <h3 class="fw-bold mb-0">@todayCompleted</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-ban"></i></div>
            <div>
                <span class="text-secondary-emphasis small">CANCELLED TODAY</span>
                <h3 class="fw-bold mb-0">@todayCancelled</h3>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fa-solid fa-shop"></i></div>
            <div>
                <span class="text-secondary-emphasis small">ACTIVE VENDORS</span>
                <h3 class="fw-bold mb-0">@dashboard.TotalVendors</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-user-friends"></i></div>
            <div>
                <span class="text-secondary-emphasis small">ACTIVE CUSTOMERS</span>
                <h3 class="fw-bold mb-0">@dashboard.TotalCustomers</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-spa"></i></div>
            <div>
                <span class="text-secondary-emphasis small">SERVICES & CATEGORIES</span>
                <h3 class="fw-bold mb-0">@dashboard.TotalServices / @dashboard.TotalCategories</h3>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="section-card h-100">
            <h4 class="section-title"><i class="fas fa-chart-pie me-2" style="color:#d4a373;"></i> Today's booking mix</h4>
            <div class="mt-4 px-2">
                @foreach (var item in bookingBreakdown)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>@item.Label</span>
                            <span class="fw-semibold">@item.Count</span>
                        </div>
                        <div class="progress rounded-pill" style="height:8px;">
                            <div class="progress-bar" role="progressbar"
                                 style="width:@item.Percent%; background:#d4a373;"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="section-card h-100">
            <h4 class="section-title"><i class="fas fa-users me-2" style="color:#d4a373;"></i> User base</h4>
            <table class="table table-admin mt-3">
                <tbody>
                    <tr><td>Sub-admin employees</td><td class="text-end fw-bold">@dashboard.TotalSubAdmins</td></tr>
                    <tr><td>Active vendors</td><td class="text-end fw-bold">@dashboard.TotalVendors</td></tr>
                    <tr><td>Active customers</td><td class="text-end fw-bold">@dashboard.TotalCustomers</td></tr>
                    <tr><td>Registered services</td><td class="text-end fw-bold">@dashboard.TotalServices</td></tr>
                    <tr><td>Service categories</td><td class="text-end fw-bold">@dashboard.TotalCategories</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    DashboardDto dashboard = new();
    int todayPending;
    int todayCompleted;
    int todayCancelled;
    int todayTotalBookings;

    List<BreakdownItem> bookingBreakdown = new();

    protected override async Task OnInitializedAsync() =>
        await LoadingService.ExecuteAsync(async () =>
        {
            dashboard = await _helperService.GetDashboardDataCounts();
            var today = DateOnly.FromDateTime(DateTime.Today);

            todayPending = (await _bookingService.GetBookingCount(today, BookingStatus.Pending)).Data;
            todayCompleted = (await _bookingService.GetBookingCount(today, BookingStatus.Completed)).Data;
            todayCancelled = (await _bookingService.GetBookingCount(today, BookingStatus.Cancelled)).Data;
            var todayConfirmed = (await _bookingService.GetBookingCount(today, BookingStatus.Confirmed)).Data;

            todayTotalBookings = todayPending + todayCompleted + todayCancelled + todayConfirmed;

            var max = Math.Max(1, todayTotalBookings);
            bookingBreakdown = new List<BreakdownItem>
            {
                new("Pending", todayPending, todayPending * 100 / max),
                new("Confirmed", todayConfirmed, todayConfirmed * 100 / max),
                new("Completed", todayCompleted, todayCompleted * 100 / max),
                new("Cancelled", todayCancelled, todayCancelled * 100 / max),
            };
        });

    record BreakdownItem(string Label, int Count, int Percent);
}
