<div class="flex-column mb-4 g-lg-5">
    <Button Color="ButtonColor.Primary"> Primary </Button>
    <Button Color="ButtonColor.Secondary"> Secondary </Button>
    <Button Color="ButtonColor.Success"> Success </Button>
</div>



<!-- ========= EMPLOYEE SECTION ========= -->
<div class="section-card" id="employeeSection">
    <div class="d-flex align-items-center justify-content-between">
        <h4 class="section-title mb-0"><i class="fas fa-user-tie me-2" style="color:#d4a373;"></i> Active Employee</h4>
        <button class="btn-outline-admin py-lg-2" @onclick="@GoToAddUser"><i class="fas fa-plus me-1"></i> Add employee</button>
    </div>
    <div class="table-responsive mt-3">
        <table class="table table-admin align-middle">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Last Name</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employeeUser in employee)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-sm">JD</span>
                                <div>@employeeUser.Name <br><small class="text-secondary">@employeeUser.Email</small></div>
                            </div>
                        </td>
                        <td>@employeeUser.LastName</td>
                        <td>@employeeUser.Phone</td>
                        <td>@(employeeUser.IsActive ? "Active" : "Inactive")</td>
                        <td>
                            <i class="fas fa-edit text-secondary me-3" @onclick="() => UpdateUser(employeeUser.Id)"></i>
                            <i class="fas fa-trash-alt text-danger-light" @onclick="() => DeleteUser(employeeUser.Id)"></i>
                        </td>
                    </tr>
                }


            </tbody>
        </table>
    </div>
    <div class="text-end mt-2">
        <a href="#" class="text-decoration-none small">view all employees <i class="fas fa-arrow-right ms-1"></i></a>
    </div>
</div>


<!-- ========= Vendor SECTION ========= -->
<div class="section-card" id="employeeSection">
    <div class="d-flex align-items-center justify-content-between">
        <h4 class="section-title mb-0"><i class="fas fa-user-tie me-2" style="color:#d4a373;"></i>Most Active Vendor</h4>
        <button class="btn-outline-admin py-lg-2" @onclick="@GoToAddUser"><i class="fas fa-plus me-1"></i> Add Vendor</button>
    </div>
    <div class="table-responsive mt-3">
        <table class="table table-admin align-middle">
            <thead>
                <tr>
                    <th>Vendor</th>
                    <th>Salon</th>
                    <th>Last Name</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
