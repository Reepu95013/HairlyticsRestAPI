@attribute [Authorize]
@page "/"
@inject NavigationManager navigationManager
@rendermode InteractiveServer


@inject IUserService _userService
@inject IHelperService _helperService
@inject ICategoryServices _categoryService
@inject LoadingService LoadingService


<Toasts class="p-3" Messages="messages" Placement="ToastsPlacement.TopRight" />

<!-- quick stats cards (handle, overview) -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-cut"></i></div>
            <div>
                <span class="text-secondary-emphasis small text-uppercase">Today's bookings</span>
                <h3 class="fw-bold mb-0">@dashboardDto.TotalTodayBookings</h3>
            </div>
        </div>
    </div>
   
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-spa"></i></div>
            <div>
                <span class="text-secondary-emphasis small">SERVICES (ACTIVE)</span>
                <h3 class="fw-bold mb-0">@dashboardDto.TotalServices</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fa-solid fa-shapes"></i></div>
            <div>
                <span class="text-secondary-emphasis small">CATEGORY</span>
                <h3 class="fw-bold mb-0">@dashboardDto.TotalCategories</h3>
            </div>
        </div>
    </div>
</div>

<!-- quick stats cards (handle, overview) -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fa-solid fa-shop"></i></div>
            <div>
                <span class="text-secondary-emphasis small text-uppercase">ACTIVE VENDOR</span>
                <h3 class="fw-bold mb-0">@dashboardDto.TotalVendors</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fas fa-user-friends"></i></div>
            <div>
                <span class="text-secondary-emphasis small">ACTIVE CUSTOMER</span>
                <h3 class="fw-bold mb-0">@dashboardDto.TotalCustomers</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon me-3"><i class="fa-solid fa-user"></i></div>
            <div>
                <span class="text-secondary-emphasis small">ACTIVE EMPLOYEES</span>
                <h3 class="fw-bold mb-0">@dashboardDto.TotalSubAdmins</h3>
            </div>
        </div>
    </div>
   
</div>


<!-- ========= EMPLOYEE SECTION ========= -->
<div class="section-card" id="employeeSection">
    <div class="d-flex align-items-center justify-content-between">
        <h4 class="section-title mb-0"><i class="fas fa-user-tie me-2" style="color:#d4a373;"></i> Active Employee</h4>
        <button class="btn-outline-admin py-lg-2" @onclick="@GoToAddUser"><i class="fas fa-plus me-1"></i> Add employee</button>
    </div>
    <div class="table-responsive mt-3">
        <table class="table table-admin align-middle">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Last Name</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var employeeUser in employee)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-sm">JD</span>
                                <div>@employeeUser.Name <br><small class="text-secondary">@employeeUser.Email</small></div>
                            </div>
                        </td>
                        <td>@employeeUser.LastName</td>
                        <td>@employeeUser.Phone</td>
                        <td>@(employeeUser.IsActive ? "Active" : "Inactive")</td>
                        <td>
                            <i class="fas fa-edit text-secondary me-3" @onclick="() => UpdateUser(employeeUser.Id)"></i>
                            <i class="fas fa-trash-alt text-danger-light" @onclick="() => DeleteUser(employeeUser.Id)"></i>
                        </td>
                    </tr>
                }


            </tbody>
        </table>
    </div>
    <div class="text-end mt-2">
        <a href="/Employee" class="text-decoration-none small">view all employees <i class="fas fa-arrow-right ms-1"></i></a>
    </div>
</div>


<!-- ========= Vendor SECTION ========= -->
<div class="section-card" id="employeeSection">
    <div class="d-flex align-items-center justify-content-between">
        <h4 class="section-title mb-0"><i class="fas fa-user-tie me-2" style="color:#d4a373;"></i>Most Active Vendor</h4>
        <button class="btn-outline-admin py-lg-2" @onclick="@GoToAddUser"><i class="fas fa-plus me-1"></i> Add Vendor</button>
    </div>
    <div class="table-responsive mt-3">
        <table class="table table-admin align-middle">
            <thead>
                <tr>
                    <th>Vendor</th>
                    <th>Salon</th>
                    <th>Last Name</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vendor in vendors)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-sm">JD</span>
                                <div>@vendor.Name <br><small class="text-secondary">@vendor.Email</small></div>
                            </div>
                        </td>
                        <td>@vendor.VendorProfileResponseDto?.ShopName</td>
                        <td>@vendor.LastName</td>
                        <td>@vendor.VendorProfileResponseDto?.ShopTelephone</td>
                        <td>@(vendor.IsActive ? "Active" : "Inactive")</td>


                        <td>
                            <i class="fas fa-edit text-secondary me-3" @onclick="() => UpdateUser(vendor.Id)"></i>
                            <i class="fas fa-trash-alt text-danger-light" @onclick="() => DeleteUser(vendor.Id)"></i>
                        </td>
                    </tr>
                }


            </tbody>
        </table>
    </div>
    <div class="text-end mt-2">
        <a href="/Vendors" class="text-decoration-none small">view all vendors <i class="fas fa-arrow-right ms-1"></i></a>
    </div>
</div>


<!-- ========= Customer SECTION ========= -->
<div class="section-card" id="employeeSection">
    <div class="d-flex align-items-center justify-content-between">
        <h4 class="section-title mb-0"><i class="fas fa-user-tie me-2" style="color:#d4a373;"></i>Most Active Customers</h4>
        <button class="btn-outline-admin py-lg-2" @onclick="@GoToAddUser"><i class="fas fa-plus me-1"></i> Add Customers</button>
    </div>
    <div class="table-responsive mt-3">
        <table class="table table-admin align-middle">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Last Name</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-sm">JD</span>
                                <div >@user.Name <br><small class="text-secondary">@user.Email</small></div>
                            </div>
                        </td>
                        <td>@user.LastName</td>
                        <td>@user.Phone</td>
                        <td>@(user.IsActive ? "Active" : "Inactive")</td>


                        <td>
                            <i class="fas fa-edit text-secondary me-3" @onclick="()=>UpdateUser(user.Id)"></i>
                            <i class="fas fa-trash-alt text-danger-light" @onclick="() => DeleteUser(user.Id)"></i>
                        </td>
                    </tr>
                }


            </tbody>
        </table>
    </div>
    <div class="text-end mt-2">
        <a href="/Users" class="text-decoration-none small">view all users <i class="fas fa-arrow-right ms-1"></i></a>
    </div>
</div>



<!-- ========= FEATURES & ACCESS combined row (2 cols) ========= -->
<div class="row g-4">
    <!-- FEATURE section (left) -->
    <div class="col-lg-12">
        <div class="section-card h-100">
            <div class="d-flex align-items-center justify-content-between">
                <h4 class="section-title mb-0"><i class="fas fa-shapes me-2" style="color:#d4a373;"></i> Categories</h4>
                <button class="btn btn-outline-admin" @onclick="GoToCategories"><i class="fas fa-plus"></i> Manage categories</button>
            </div>
            <div class="mt-3">
                <table class="table table-admin">
                    <thead>
                        <tr><th>Category</th><th>Description</th><th>Parent</th><th>Action</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in categories.Take(10))
                        {
                        <tr>
                            <td class="text-capitalize">@cat.CategoryName</td>
                            <td class="small text-secondary">@(cat.Description?.Length > 50 ? cat.Description[..50] + "…" : cat.Description)</td>
                            <td>@(cat.ParentCategoryId == null ? "—" : "Subcategory")</td>
                            <td>
                                <i class="fas fa-edit text-secondary me-3" style="cursor:pointer" @onclick="GoToCategories"></i>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-2">
                <span class="feature-tag"><i class="far fa-clock me-1"></i> @categories.Count category(ies) listed</span>
            </div>
        </div>
    </div>

    <!-- ACCESS section (right)  -->
  
</div>

<!-- extra row: "handle" section / recent activity (just to tie handle concept) -->
<div class="row mt-4">
    <div class="col-12">
        <div class="section-card d-flex align-items-center justify-content-between p-3">
            <div><i class="fas fa-hand-paper me-2 fs-4" style="color:#d4a373;"></i> <strong>Handle incoming requests:</strong> 2 new appointment requests pending</div>
            <button class="btn btn-dark px-5 py-2 rounded-pill" style="background:#1e2a3a;" @onclick="GoToAppointments">Review bookings</button>
        </div>
    </div>
</div>


@code {
    DashboardDto dashboardDto = new(); 
    List<UserResponseDto> users = new();
    List<UserResponseDto> vendors = new();
    List<UserResponseDto> employee = new();
    List<CategoryResponseDto> categories = new(); 

    private List<ToastMessage> messages = new();




    async Task LoadUsers()
    {
        dashboardDto = await _helperService.GetDashboardDataCounts();
        users = await _userService.GetUsersAsync(UserRole.Customer, 1, 10);
        vendors = await _userService.GetUsersAsync(UserRole.Vendor, 1, 10);
        employee = await _userService.GetUsersAsync(UserRole.SubAdmin, 1, 10);

        var catResponse = await _categoryService.GetCategoryListAsync();
        if (catResponse.Success && catResponse.Data != null)
        {
            categories = catResponse.Data;
        }
    }

    protected override async Task OnInitializedAsync() =>
        await LoadingService.ExecuteAsync(LoadUsers);

    private void GoToAddUser() => navigationManager.NavigateTo("/Add-User", true);
    private void GoToCategories() => navigationManager.NavigateTo("/Categories", true);
    private void GoToAppointments() => navigationManager.NavigateTo("/Appointments", true);


    private void UpdateUser(int id)
    {
        navigationManager.NavigateTo($"/Edit-User/{id}", true);

    }

    private async Task DeleteUser(int id) =>
        await LoadingService.ExecuteAsync(async () =>
        {
            var response = await _userService.DeleteUserAsync(id);
            messages.Add(new ToastMessage
            {
                Type = response.Success ? ToastType.Success : ToastType.Danger,
                Title = response.Success ? "Success!" : "Error!",
                Message = response.Data
            });
            if (response.Success) await LoadUsers();
        });






}
