</div>



<!-- ========= FEATURES & ACCESS combined row (2 cols) ========= -->
<div class="row g-4">
    <!-- FEATURE section (left) -->
    <div class="col-lg-12">
        <div class="section-card h-100">
            <div class="d-flex align-items-center justify-content-between">
                <h4 class="section-title mb-0"><i class="fas fa-star me-2" style="color:#d4a373;"></i> Salon Service</h4>
                <button class="btn btn-outline-admin"><i class="fas fa-plus"></i> Service</button>
            </div>
            <div class="mt-3">
                <table class="table table-admin">
                    <thead>
                        <tr><th>Service name</th><th>Category</th><th>Pricing</th> <th>Discount</th><th>Duration</th><th>Active</th><th>Action</th></tr>
                    </thead>
                    <tbody>
                        @foreach(var service in services){
                        <tr>
                            <td class="text-capitalize">@service.ServiceName</td>
                            <td>@service.CategoryResponseDto?.CategoryName</td>
                            <td>$ @service.Price</td>
                                <td>
                                    <i class="fas fa-tag text-secondary"></i> @(service.OffPrice ?? 0)
                            </td>
                            <td><i class="fas fa-clock text-secondary"></i> @service.Duration Minutes</td>
                             <td>@(service.Status ? "Active" : "Inactive")</td>
                                <td>
                                    <i class="fas fa-edit text-secondary me-3"></i>
                                    <i class="fas fa-trash-alt text-danger-light"></i>
                                </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-2">
                <span class="feature-tag"><i class="far fa-clock me-1"></i> 18 active features</span>
            </div>
        </div>
    </div>

    <!-- ACCESS section (right)  -->
  
</div>

<!-- extra row: "handle" section / recent activity (just to tie handle concept) -->
<div class="row mt-4">
    <div class="col-12">
        <div class="section-card d-flex align-items-center justify-content-between p-3">
            <div><i class="fas fa-hand-paper me-2 fs-4" style="color:#d4a373;"></i> <strong>Handle incoming requests:</strong> 2 new appointment requests pending</div>
            <button class="btn btn-dark px-5 py-2 rounded-pill" style="background:#1e2a3a;">Review bookings</button>
        </div>
    </div>
</div>


@code {

    List<UserResponseDto> users = new();
    List<UserResponseDto> vendors = new();
    List<UserResponseDto> employee = new();
    List<ServiceResponseDto> services = new(); 
    private List<ToastMessage> messages = new();


    async Task LoadUsers()
    {
        users = await _userService.GetUsersAsync(UserRole.Customer, 1, 10);
        vendors = await _userService.GetUsersAsync(UserRole.Vendor, 1, 10);
        employee = await _userService.GetUsersAsync(UserRole.SubAdmin, 1, 10);

        var response =   await _serviceService.GetServiceListAsync();
        if (response.Success && response.Data!=null)
        {
            services = response.Data;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private void GoToAddUser()
    {
        navigationManager.NavigateTo("/Add-User", true);
    }


    private void UpdateUser(int id)
    {
        navigationManager.NavigateTo($"/Edit-User/{id}", true);

    }

    private async Task DeleteUser(int id) {
        LoadingService.IsLoading = true;
        var response  =   await _userService.DeleteUserAsync(id);

        if (response.Success)
        {

            messages.Add(new ToastMessage
            {
                Type = ToastType.Success,
                Title = "Success!",
                Message = response.Data
            });

            await LoadUsers();
            LoadingService.IsLoading = false;

        }
        else
        {
            messages.Add(new ToastMessage
            {
                Type = ToastType.Danger,
                Title = "Error!",
                Message = response.Data
            });
            LoadingService.IsLoading = false;
        }
    }

    private async Task DeleteUser1(int id)
    {
        LoadingService.IsLoading = true;

        await Task.Yield(); // important

        try
        {
            await Task.Delay(3000);
            // await _userService.DeleteUser(id);
        }
        finally
        {
            LoadingService.IsLoading = false;
        }


    }



   

    






}
