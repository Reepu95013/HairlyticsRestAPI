    </div>
    <div class="text-end mt-2">
        <a href="#" class="text-decoration-none small">view all employees <i class="fas fa-arrow-right ms-1"></i></a>
    </div>
</div>


<!-- ========= Customer SECTION ========= -->
<div class="section-card" id="employeeSection">
    <div class="d-flex align-items-center justify-content-between">
        <h4 class="section-title mb-0"><i class="fas fa-user-tie me-2" style="color:#d4a373;"></i>Most Active Customers</h4>
        <button class="btn-outline-admin py-lg-2" @onclick="@GoToAddUser"><i class="fas fa-plus me-1"></i> Add Customers</button>
    </div>
    <div class="table-responsive mt-3">
        <table class="table table-admin align-middle">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Last Name</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
