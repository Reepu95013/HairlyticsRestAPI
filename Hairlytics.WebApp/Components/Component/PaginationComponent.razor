@rendermode InteractiveServer

<div class="d-flex flex-wrap justify-content-between align-items-center mt-3 gap-2">
    <span class="small text-secondary">
        @if (TotalCount == 0)
        {
            <text>No records</text>
        }
        else
        {
            <text>Showing @StartIndex–@EndIndex of @TotalCount</text>
        }
    </span>
    <div class="d-flex align-items-center gap-2">
        <label class="small text-secondary mb-0">Per page</label>
        <select class="input-group-custom py-1 px-2" style="width:auto; min-width:70px;"
                value="@PageSize" @onchange="OnPageSizeChanged">
            @foreach (var size in PageSizeOptions)
            {
                <option value="@size">@size</option>
            }
        </select>
        <button type="button" class="btn-outline-admin py-1 px-3" disabled="@(!HasPrevious)" @onclick="GoPrevious">
            <i class="fas fa-chevron-left"></i>
        </button>
        <span class="small fw-semibold px-1">Page @PageNumber of @TotalPages</span>
        <button type="button" class="btn-outline-admin py-1 px-3" disabled="@(!HasNext)" @onclick="GoNext">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>
</div>

@code {
    [Parameter] public int PageNumber { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public EventCallback<PaginationState> OnPageChanged { get; set; }

    private static readonly int[] PageSizeOptions = { 5, 10, 20, 50 };

    int TotalPages => PageSize <= 0 ? 0 : (int)Math.Ceiling(TotalCount / (double)PageSize);
    bool HasPrevious => PageNumber > 1;
    bool HasNext => PageNumber < TotalPages;
    int StartIndex => TotalCount == 0 ? 0 : ((PageNumber - 1) * PageSize) + 1;
    int EndIndex => Math.Min(PageNumber * PageSize, TotalCount);

    async Task GoPrevious()
    {
        if (HasPrevious)
            await OnPageChanged.InvokeAsync(new PaginationState(PageNumber - 1, PageSize));
    }

    async Task GoNext()
    {
        if (HasNext)
            await OnPageChanged.InvokeAsync(new PaginationState(PageNumber + 1, PageSize));
    }

    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize) && newSize > 0)
            await OnPageChanged.InvokeAsync(new PaginationState(1, newSize));
    }

    public record PaginationState(int PageNumber, int PageSize);
}
